use_frameworks!

platform :ios, '15.0'

target 'releasebird-ios-sdk_Example' do
  pod 'Releasebird', :path => '../'

  target 'releasebird-ios-sdk_Tests' do
    inherit! :search_paths

    
  end
end

# Current Xcode versions only build iOS 15 and later; the SDK itself still declares iOS 12.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
